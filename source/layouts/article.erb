<% wrap_layout :layout do %>
    <% @art = current_page %>
    <article class="hentry article" data-pagefind-body itemscope itemtype="https://schema.org/Article">
        <span data-pagefind-filter="type" style="display:none;">blog</span>
        <h1 itemprop="headline"><%= current_page.title %></h1>
        <meta itemprop="datePublished" content="<%= current_page.date.strftime('%Y-%m-%dT%H:%M:%SZ') %>">
        <meta itemprop="image" content="https://paperswelove.org/images/papers-we-love-ogp.png">
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
          <meta itemprop="name" content="<%= current_page.data.author %>">
        </span>
        <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
          <meta itemprop="name" content="Papers We Love">
          <meta itemprop="url" content="https://paperswelove.org/">
          <link itemprop="logo" href="https://paperswelove.org/images/papers-we-love-ogp.png">
        </span>
        <%=
          case current_page.data.category
          when "meetup" then partial 'partials/_presenter'
          when "news" then partial 'partials/_news'
          end
        %>
        <section itemprop="articleBody">
        <%= yield %>
        </section>
        <footer class="article-metadata">
            <em>Tags:</em>
            <% current_page.tags.each do |tag| %>
                <%= link_to tag, "/tags/#{tag}" %>
            <% end %>
            <em>Category:</em>
            <%= link_to current_page.data.category, "/categories/#{current_page.data.category}"%>
            <em>Posted by:</em>
            <%= current_page.data.author %>
        </footer>
    </article>
<% end %>
